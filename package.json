{
  "name": "cartucho-ipfs",
  "private": true,
  "description": "Emulador retro descentralizado. O site é estático: isto existe só para gerar o CSS.",
  "scripts": {
    "build": "npm run css && npm run version",
    "css": "npx --yes tailwindcss@3.4.15 -c tailwind.config.js -i assets/css/tailwind.src.css -o assets/css/tailwind.css --minify",
    "css:watch": "npx --yes tailwindcss@3.4.15 -c tailwind.config.js -i assets/css/tailwind.src.css -o assets/css/tailwind.css --watch",
    "version": "node scripts/version.mjs",
    "serve": "python3 -m http.server 8000 --bind 127.0.0.1"
  },
  "devDependencies": {
    "tailwindcss": "3.4.15"
  }
}
